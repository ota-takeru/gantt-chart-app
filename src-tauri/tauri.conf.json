{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gantt Chart",
  "version": "../package.json",
  "identifier": "com.ganttchart.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gantt Chart",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRjAwQjg4RDA5OUMyREQKUldUZHdwblFpQXZ3NzNaQnloVHpDRVZZVkNHS0FNTmlYL1BjUm1YeWo2VjM3K2xLNVRyTGtoWU0K",
      "endpoints": [
        "https://github.com/ota-takeru/gantt-chart-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
